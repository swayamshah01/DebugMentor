# ─────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/debugmentor_db

# Secret key for signing tokens (Phase 2: JWT)
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Set to False in production
DEBUG=True

# ── Phase 3 ───────────────────────────────────────────────────────
# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Redis connection string for caching and hint states
REDIS_URL=redis://localhost:6379
